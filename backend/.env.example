# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL & Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Civic Fusion Parameters (Production-Validated)
FUSION_AUTO_MERGE_THRESHOLD=0.85
FUSION_REVIEW_THRESHOLD=0.65
FUSION_MAX_DISTANCE_KM=0.5
FUSION_MAX_TIME_HOURS=48
